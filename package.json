{
  "name": "api-monitoring-service",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "npm run build --workspace=web",
    "preview": "npm run preview --workspace=web",
    "lint:server": "npm run lint --workspace=server",
    "lint:server:fix": "npm run lint:fix --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
